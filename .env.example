# Copie ce fichier en .env.local et mets tes vraies clés dans .env.local
# (jamais dans ce fichier : il est envoyé sur GitHub).

# Quelle IA utiliser pour lire le document : "claude" ou "gemini"
# (la conversation vocale utilise toujours Gemini : GEMINI_API_KEY obligatoire)
AI_PROVIDER=gemini

# Clé Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optionnel : modèle Claude (par défaut claude-sonnet-5-5)
CLAUDE_MODEL=claude-sonnet-5-5

# Clé Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optionnel : modèle Gemini. Laisse vide pour utiliser gemini-flash-latest
# (toujours le modèle Flash actuel de Google).
GEMINI_MODEL=
