# Copie ce fichier en .env.local et mets tes vraies clés dans .env.local
# (jamais dans ce fichier : il est envoyé sur GitHub).

# Quelle IA utiliser : "claude" ou "gemini"
AI_PROVIDER=claude

# Clé Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optionnel : modèle Claude (par défaut claude-sonnet-5-5)
CLAUDE_MODEL=claude-sonnet-5-5

# Clé Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optionnel : modèle Gemini (par défaut gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
